# Copy to .env.local (dev) or /home/pixcherry/app/.env (server). Never commit real values.

# Public URLs
APP_URL=https://pixcherry.com
IMG_URL=https://img.pixcherry.com

# Postgres (Supabase session pooler, port 5432). Local: postgres://postgres:postgres@127.0.0.1:54329/pixcherry
DATABASE_URL=

# 32+ random chars each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=

# Comma-separated emails that become platform admins on login
ADMIN_EMAILS=

# Cloudflare R2 (leave R2_BUCKET empty locally to use .local-storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# CHIP (platform account)
PLATFORM_CHIP_BRAND_ID=
PLATFORM_CHIP_SECRET_KEY=

# ZeptoMail
ZEPTOMAIL_TOKEN=
EMAIL_FROM=no-reply@pixcherry.com

# Cloudflare Turnstile (site key is also baked into the build by scripts/deploy.mjs)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Worker
WORKER_CONCURRENCY=1

# Dev/tests only (ignored in production): fixed organiser login code
DEV_FIXED_LOGIN_CODE=
