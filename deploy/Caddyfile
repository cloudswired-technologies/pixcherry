# PixCherry on the VPS. Cloudflare terminates visitor TLS; Caddy terminates the
# Cloudflare -> origin leg with a Cloudflare Origin CA certificate and forwards
# to Next.js. Photos never pass through here: browsers upload straight to R2
# and images are served from img.<domain> (R2 custom domain).

{
	admin localhost:2019
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Only cover/logo uploads come through the app (max 10 MB).
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto https
		transport http {
			read_timeout 60s
			# Album ZIPs stream for minutes.
			write_timeout 30m
		}
	}

	log {
		output file /var/log/caddy/pixcherry.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

:80 {
	redir https://{host}{uri} permanent
}
